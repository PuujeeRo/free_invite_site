# Naashir environment variables. Copy to .env.local and fill in.
# This file holds no real values and is safe to commit; .env.local is not.
#
# The same names are set as service variables on the host (Railway, Vercel).
# NEXT_PUBLIC_* values are read at build time: after changing one on the host,
# redeploy -- a restart is not enough.

# ---------- Required ----------

# Supabase project (dashboard -> Project Settings -> API).
# No hosted project yet? See "Local development" at the end of this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser -- bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
# Only when the Supabase project is shared with another app: the schema
# Naashir's tables were installed into (scripts/hosted-schema.ts), which also
# has to be listed under Project Settings -> API -> Exposed schemas. Leave
# blank for a project of its own, where everything is in "public".
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=

# Public base URL, used to build invitation links and callback addresses.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the daily cleanup of expired invitations (/api/cron/cleanup).
# Any long random string. Vercel sends it automatically with the cron call in
# vercel.json; another scheduler must send "Authorization: Bearer <value>".
# Without it the cleanup refuses to run and nothing is ever deleted.
CRON_SECRET=

# ---------- Recommended ----------

# Signs the /api/img links that crop external slider images, so the route
# cannot be used as an open image proxy. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset; with neither set, slider images are
# loaded straight from their own links, uncropped.
IMAGE_PROXY_SECRET=

# ---------- Optional: tips ----------

# QPay merchant credentials, for online tipping on /tip. Leave blank and the
# tip page shows the bank details (TIP_BANK_*) instead.
# QPay issues these as a username and password. QPAY_CLIENT_ID/QPAY_CLIENT_SECRET
# are still read as aliases so an older deploy keeps working.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Overrides the merchant API base URL -- set this to QPay's sandbox host while
# testing so a sandbox invoice never hits the live merchant account.
QPAY_BASE_URL=
# The receiver code QPay records against each invoice. "terminal" is QPay's
# generic default and is what is used when this is unset; some merchant
# contracts require a specific code instead.
QPAY_INVOICE_RECEIVER_CODE=

# Bank transfer details shown on /tip when QPay is not set up. With neither,
# the page says tipping is not available yet.
TIP_BANK_NAME=
TIP_BANK_ACCOUNT=
TIP_BANK_HOLDER=

# ---------- Optional: invitation email ----------

# Resend (resend.com), the site's own sender. Leave blank and emails are
# logged to the console instead of being sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Naashir <invites@naashir.com>

# Lets an organizer connect their own Gmail and send invitation emails from
# their address (see "Email" in the README). Create an OAuth client of type
# "Web application" in Google Cloud, enable the Gmail API, and add
# <NEXT_PUBLIC_SITE_URL>/api/google/callback as an authorised redirect URI.
# Leave blank and the option is simply not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail tokens. Falls back to a key derived from
# SUPABASE_SERVICE_ROLE_KEY; set this if you may ever rotate that key, because
# changing the key in use disconnects every organizer's Gmail.
GMAIL_TOKEN_SECRET=

# ---------- Optional: ads ----------

# Google AdSense. Leave blank until you have an approved account -- the ad
# slot on invitation pages (components/ads) renders nothing in production (a
# placeholder in dev) until both are set. clientId looks like
# "ca-pub-XXXXXXXXXXXXXXXX"; the slot id comes from the ad unit you create for
# this placement in AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_INVITE_SLOT_ID=

# ---------- Local development only ----------

# Runs the app against your own PostgreSQL and a natively-run PostgREST instead
# of a Supabase project (supabase/localdev/README.md has the setup). Uncomment
# all of them together, and set the three Supabase values above to their
# local-dev equivalents as that README describes (NEXT_PUBLIC_SUPABASE_URL
# becomes http://localhost:3000).
#
# Never set these on a host. LOCAL_DEV_MODE is ignored in production builds and
# on Vercel, but it replaces real sign-in with /dev-login, so keep it out.
#LOCAL_DEV_MODE=true
#LOCAL_DEV_POSTGREST_URL=http://127.0.0.1:3211
#LOCAL_DEV_PG_URL=postgres://<user>:<password>@127.0.0.1:5432/naashir_dev
#SUPABASE_JWT_SECRET=
