# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# No hosted project yet? See supabase/localdev/README.md -- runs against your
# own local PostgreSQL instead, no Docker required. It sets these same vars to
# local-dev values (NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000, etc.) plus
# a few local-dev-only ones (LOCAL_DEV_MODE, LOCAL_DEV_POSTGREST_URL,
# LOCAL_DEV_PG_URL, SUPABASE_JWT_SECRET) documented there, not here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser -- bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used to build invitation links (naashir.com/... in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which payment provider to use: qpay | stripe | mock.
# Leave blank to auto-detect (QPay if configured, else Stripe, else the mock
# provider). Set it explicitly in production: a pinned provider with missing
# credentials fails loudly instead of silently falling back to the mock provider
# and handing out free upgrades.
PAYMENT_PROVIDER=

# QPay merchant credentials. Leave blank in dev -- lib/payments falls back to a
# mock provider that drives a local checkout page instead of a real gateway.
# QPay issues these as a username and password. QPAY_CLIENT_ID/QPAY_CLIENT_SECRET
# are still read as aliases so an older deploy keeps working.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Optional. Overrides the merchant API base URL -- set this to QPay's sandbox
# host while testing so a sandbox invoice never hits the live merchant account.
QPAY_BASE_URL=
# Optional. The receiver code QPay records against each invoice. "terminal" is
# QPay's generic default and is what is used when this is unset; some merchant
# contracts require a specific code instead.
QPAY_INVOICE_RECEIVER_CODE=

# Stripe. Leave blank until you have an account -- nothing here is required for
# the app to run. Secret key from the Stripe dashboard (use a sk_test_... key
# while developing); the webhook secret comes from the webhook endpoint you
# create pointing at /api/payments/stripe/webhook, or from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ISO 4217 currency Stripe should charge in. Defaults to MNT. See the README
# note before using Stripe for the 999 MNT per-event price -- that amount falls
# below Stripe's minimum charge, so Stripe suits the larger yearly plan instead.
STRIPE_CURRENCY=MNT

# Resend (resend.com) for email invites. Leave blank in dev -- lib/email/provider.ts
# falls back to logging the email to the console instead of sending it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Naashir <invites@naashir.com>

# Google AdSense. Leave blank until you have an approved account -- the ad
# slot on free-plan invitation pages (components/ads) renders nothing in
# production (a placeholder in dev) until both are set. Never shown on paid
# invitations regardless of this config -- "no watermark, no ads" is part of
# what upgrading buys. clientId looks like "ca-pub-XXXXXXXXXXXXXXXX"; the slot
# id comes from the ad unit you create for this placement in AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_INVITE_SLOT_ID=

# Optional. Signs the /api/img links that crop external slider images, so the
# route cannot be used as an open image proxy. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset; with neither set, slider images are
# loaded straight from their own links, uncropped.
IMAGE_PROXY_SECRET=

# Required for the daily cleanup of expired invitations (/api/cron/cleanup).
# Any long random string. Vercel sends it automatically with the cron call in
# vercel.json; another scheduler must send "Authorization: Bearer <value>".
# Without it the cleanup refuses to run and nothing is ever deleted.
CRON_SECRET=

# Optional. Lets an organizer connect their own Gmail and send invitation
# emails from their address (see "Email" in the README). Create an OAuth client
# of type "Web application" in Google Cloud, enable the Gmail API, and add
# <NEXT_PUBLIC_SITE_URL>/api/google/callback as an authorised redirect URI.
# Leave blank and the option is simply not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Encrypts the stored Gmail tokens. Falls back to a key derived from
# SUPABASE_SERVICE_ROLE_KEY; set this if you may ever rotate that key, because
# changing the key in use disconnects every organizer's Gmail.
GMAIL_TOKEN_SECRET=

# Optional. Tips are taken with QPay when the QPAY_* values above are set.
# Without QPay, the /tip page shows these bank details instead; with neither,
# it says tipping is not available yet.
TIP_BANK_NAME=
TIP_BANK_ACCOUNT=
TIP_BANK_HOLDER=
